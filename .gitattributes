# Git LFS — track large binary demo / preview assets so the repo stays slim.
# Run `git lfs install` once per clone before pulling.

# Office documents
*.pptx filter=lfs diff=lfs merge=lfs -text
*.ppt  filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text
*.xls  filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text
*.doc  filter=lfs diff=lfs merge=lfs -text

# Books / publishing
*.pdf  filter=lfs diff=lfs merge=lfs -text
*.epub filter=lfs diff=lfs merge=lfs -text

# Media (uncomment if/when added to demos)
# *.mp4  filter=lfs diff=lfs merge=lfs -text
# *.webm filter=lfs diff=lfs merge=lfs -text
# *.mov  filter=lfs diff=lfs merge=lfs -text
# *.mp3  filter=lfs diff=lfs merge=lfs -text
# *.wav  filter=lfs diff=lfs merge=lfs -text

# Big images (small icons stay regular git)
# Tracked under public/demo/ only — keeps logo.svg etc. out of LFS.
apps/playground/public/demo/*.png filter=lfs diff=lfs merge=lfs -text
apps/playground/public/demo/*.jpg filter=lfs diff=lfs merge=lfs -text
apps/playground/public/demo/*.jpeg filter=lfs diff=lfs merge=lfs -text
apps/playground/public/demo/*.gif filter=lfs diff=lfs merge=lfs -text
apps/playground/public/demo/*.webp filter=lfs diff=lfs merge=lfs -text

{
  "name": "@lamberl-lee/file-preview",
  "version": "0.8.0",
  "description": "React file viewer for 20+ formats—PDF, DOCX, PPTX, XLSX, EPUB, Markdown, code and media—rendered entirely in the browser with no server uploads.",
  "keywords": [
    "react",
    "react-component",
    "file-preview",
    "file-viewer",
    "react-file-viewer",
    "document-viewer",
    "document-preview",
    "office-viewer",
    "pdf-viewer",
    "word-viewer",
    "excel-viewer",
    "powerpoint-viewer",
    "docx",
    "pptx",
    "xlsx",
    "epub-viewer",
    "markdown-viewer",
    "code-viewer",
    "browser",
    "client-side"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "author": "CoderLambert",
  "homepage": "https://coderlambert.github.io/filevista/",
  "bugs": {
    "url": "https://github.com/CoderLambert/filevista/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoderLambert/filevista.git",
    "directory": "packages/file-preview"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./full": {
      "types": "./dist/entries/full.d.ts",
      "import": "./dist/entries/full.js"
    },
    "./plugins/pptx": {
      "types": "./dist/entries/plugins/pptx.d.ts",
      "import": "./dist/entries/plugins/pptx.js"
    },
    "./plugins/pdf": {
      "types": "./dist/entries/plugins/pdf.d.ts",
      "import": "./dist/entries/plugins/pdf.js"
    },
    "./plugins/docx": {
      "types": "./dist/entries/plugins/docx.d.ts",
      "import": "./dist/entries/plugins/docx.js"
    },
    "./plugins/xlsx": {
      "types": "./dist/entries/plugins/xlsx.d.ts",
      "import": "./dist/entries/plugins/xlsx.js"
    },
    "./plugins/rtf": {
      "types": "./dist/entries/plugins/rtf.d.ts",
      "import": "./dist/entries/plugins/rtf.js"
    },
    "./plugins/zip": {
      "types": "./dist/entries/plugins/zip.d.ts",
      "import": "./dist/entries/plugins/zip.js"
    },
    "./plugins/epub": {
      "types": "./dist/entries/plugins/epub.d.ts",
      "import": "./dist/entries/plugins/epub.js"
    },
    "./styles/index.css": "./dist/styles/index.css",
    "./styles/*.css": "./dist/styles/*.css",
    "./scripts/copy-pdf-worker.mjs": "./scripts/copy-pdf-worker.mjs",
    "./scripts/copy-rtfjs-bundles.mjs": "./scripts/copy-rtfjs-bundles.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts",
    "docs",
    "README.md",
    "LICENSE",
    "COPYING"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "copy:pdf-worker": "node scripts/copy-pdf-worker.mjs",
    "copy:rtfjs-bundles": "node scripts/copy-rtfjs-bundles.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "docx-preview": "^0.3.7",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.4.0",
    "@aiden0z/pptx-renderer": "^1.2.0",
    "rtf.js": "^3.0.9"
  },
  "peerDependenciesMeta": {
    "docx-preview": {
      "optional": true
    },
    "exceljs": {
      "optional": true
    },
    "jszip": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "@aiden0z/pptx-renderer": {
      "optional": true
    },
    "rtf.js": {
      "optional": true
    }
  },
  "dependencies": {
    "dompurify": "^3.4.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "docx-preview": "^0.3.7",
    "exceljs": "^4.4.0",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "pdfjs-dist": "4.4.168",
    "@aiden0z/pptx-renderer": "^1.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rtf.js": "^3.0.9",
    "tsup": "^8.3.0",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "LGPL-3.0-or-later",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
